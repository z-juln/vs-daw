    "configuration": {
      "title": "VS DAW",
      "properties": {
        "vsDaw.fileExtensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "daw"
          ]
        },
        "vsDaw.keyMap": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {
            "a": "kick",
            "s": "snare",
            "d": "ch",
            "f": "oh",
            "g": "clap",
            "q": "tom1",
            "w": "tom2",
            "e": "tom3",
            "r": "crash",
            "t": "ride"
          }
