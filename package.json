{
  "name": "vs-daw",
  "displayName": "VS DAW",
  "description": "纯文本多轨 DAW：鼓/钢琴/吉他/贝斯、MIDI+SoundFont 播放",
  "version": "1.0.4",
  "license": "MIT",
  "publisher": "vs-daw",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:vs-daw",
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "vs-daw",
        "aliases": [
          "VS DAW",
          "daw"
        ],
        "extensions": [
          ".daw"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./media/daw-file-light.svg",
          "dark": "./media/daw-file-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "vs-daw",
        "scopeName": "source.vs-daw",
        "path": "./syntaxes/vs-daw.tmLanguage.json"
      }
    ],
    "customEditors": [
      {
        "viewType": "vsDaw.gridEditor",
        "displayName": "VS DAW Grid",
        "selector": [
          {
            "filenamePattern": "*.daw"
          }
        ],
        "priority": "default"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vsDaw",
          "title": "VS DAW",
          "icon": "media/daw.svg"
        }
      ]
    },
    "views": {
      "vsDaw": [
        {
          "id": "vsDaw.playlist",
          "name": "播放列表",
          "type": "webview"
        },
        {
          "id": "vsDaw.recorder",
          "name": "键盘录制",
          "type": "webview"
        },
        {
          "id": "vsDaw.creator",
          "name": "创建"
        }
      ],
      "panel": [
        {
          "id": "vsDaw.learnHud",
          "name": "跟练",
          "type": "webview",
          "when": "vsDaw.learnActive"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "vsDaw.playlist",
        "contents": "谱库为空。\n[创建工程](command:vsDaw.newScore)"
      }
    ],
    "commands": [
      {
        "command": "vsDaw.playPause",
        "title": "播放/暂停",
        "icon": "$(play)",
        "category": "VS DAW"
      },
      {
        "command": "vsDaw.editorPlay",
        "title": "播放",
        "icon": "$(play)",
        "category": "VS DAW"
      },
      {
        "command": "vsDaw.editorPause",
        "title": "暂停",
        "icon": "$(debug-pause)",
        "category": "VS DAW"
      },
      {
        "command": "vsDaw.cloneScore",
        "title": "克隆",
        "icon": "$(copy)",
        "category": "VS DAW"
      },
      {
        "command": "vsDaw.restart",
        "title": "VS DAW: Restart"
      },
      {
        "command": "vsDaw.stop",
        "title": "VS DAW: Stop"
      },
      {
        "command": "vsDaw.enablePadMode",
        "title": "VS DAW: 开启 Pad 模式",
        "category": "VS DAW"
      },
      {
        "command": "vsDaw.togglePadMode",
        "title": "VS DAW: 切换 Pad 模式",
        "category": "VS DAW"
      },
      {
        "command": "vsDaw.exitPadMode",
        "title": "VS DAW: 退出 Pad 模式",
        "category": "VS DAW"
      },
      {
        "command": "vsDaw.insertRuler",
        "title": "VS DAW: Insert Ruler"
      },
      {
        "command": "vsDaw.formatScore",
        "title": "VS DAW: Format Score"
      },
      {
        "command": "vsDaw.newScore",
        "title": "VS DAW: New Score",
        "icon": "$(new-file)"
      },
      {
        "command": "vsDaw.padHit",
        "title": "VS DAW: Pad Hit"
      },
      {
        "command": "vsDaw.openManual",
        "title": "VS DAW: 打开说明书",
        "icon": "$(book)"
      },
      {
        "command": "vsDaw.warmUpAudio",
        "title": "VS DAW: 启动音频引擎"
      },
      {
        "command": "vsDaw.pickTrack",
        "title": "VS DAW: 切换乐器"
      },
      {
        "command": "vsDaw.seek",
        "title": "VS DAW: Seek"
      },
      {
        "command": "vsDaw.octaveUp",
        "title": "VS DAW: 升八度"
      },
      {
        "command": "vsDaw.octaveDown",
        "title": "VS DAW: 降八度"
      },
      {
        "command": "vsDaw.exportMidi",
        "title": "VS DAW: 导出 MIDI"
      },
      {
        "command": "vsDaw.importMidi",
        "title": "VS DAW: 导入 MIDI"
      },
      {
        "command": "vsDaw.syncLibrary",
        "title": "VS DAW: 同步示例工程",
        "icon": "$(cloud-download)"
      },
      {
        "command": "vsDaw.refreshLibrary",
        "title": "VS DAW: 刷新播放列表",
        "icon": "$(refresh)"
      },
      {
        "command": "vsDaw.openLibraryScore",
        "title": "VS DAW: 打开工程"
      },
      {
        "command": "vsDaw.playLibraryScore",
        "title": "VS DAW: 播放工程",
        "icon": "$(play)"
      },
      {
        "command": "vsDaw.pauseLibraryScore",
        "title": "VS DAW: 暂停工程",
        "icon": "$(debug-pause)"
      },
      {
        "command": "vsDaw.deleteLibraryScore",
        "title": "VS DAW: 删除工程",
        "icon": "$(trash)"
      },
      {
        "command": "vsDaw.createLibraryFolder",
        "title": "VS DAW: 新建目录",
        "icon": "$(new-folder)"
      },
      {
        "command": "vsDaw.renameLibraryFolder",
        "title": "VS DAW: 重命名",
        "icon": "$(edit)"
      },
      {
        "command": "vsDaw.renameLibraryItem",
        "title": "VS DAW: 重命名",
        "icon": "$(edit)"
      },
      {
        "command": "vsDaw.deleteLibraryFolder",
        "title": "VS DAW: 删除目录",
        "icon": "$(trash)"
      },
      {
        "command": "vsDaw.newScoreInFolder",
        "title": "VS DAW: 在此目录创建工程",
        "icon": "$(new-file)"
      },
      {
        "command": "vsDaw.moveLibraryItems",
        "title": "VS DAW: 移动谱库条目"
      },
      {
        "command": "vsDaw.collapsePlaylist",
        "title": "VS DAW: 折叠播放列表",
        "icon": "$(collapse-all)"
      },
      {
        "command": "vsDaw.creatorSetFolder",
        "title": "VS DAW: 设置创建目录"
      },
      {
        "command": "vsDaw.toggleRecording",
        "title": "VS DAW: 切换录制"
      },
      {
        "command": "vsDaw.toggleMelodyLearn",
        "title": "VS DAW: 跟练",
        "category": "VS DAW",
        "icon": "$(circle-outline)"
      },
      {
        "command": "vsDaw.creatorSetName",
        "title": "VS DAW: 设置名称"
      },
      {
        "command": "vsDaw.creatorSetBpm",
        "title": "VS DAW: 设置 BPM"
      },
      {
        "command": "vsDaw.creatorSetBars",
        "title": "VS DAW: 设置小节数"
      },
      {
        "command": "vsDaw.creatorCreate",
        "title": "VS DAW: 创建工程"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "vsDaw.editorPlay",
          "when": "(resourceExtname == .daw || activeCustomEditorId == vsDaw.gridEditor) && !vsDaw.playing",
          "group": "navigation@1"
        },
        {
          "command": "vsDaw.editorPause",
          "when": "(resourceExtname == .daw || activeCustomEditorId == vsDaw.gridEditor) && vsDaw.playing",
          "group": "navigation@1"
        },
        {
          "command": "vsDaw.cloneScore",
          "when": "resourceExtname == .daw || activeCustomEditorId == vsDaw.gridEditor",
          "group": "navigation@2"
        },
        {
          "command": "vsDaw.toggleMelodyLearn",
          "when": "resourceExtname == .daw || activeCustomEditorId == vsDaw.gridEditor",
          "group": "navigation@3"
        }
      ],
      "view/title": [
        {
          "command": "vsDaw.refreshLibrary",
          "when": "view == vsDaw.playlist",
          "group": "navigation"
        },
        {
          "command": "vsDaw.syncLibrary",
          "when": "view == vsDaw.playlist",
          "group": "navigation"
        },
        {
          "command": "vsDaw.newScore",
          "when": "view == vsDaw.playlist",
          "group": "navigation"
        },
        {
          "command": "vsDaw.createLibraryFolder",
          "when": "view == vsDaw.playlist",
          "group": "navigation"
        },
        {
          "command": "vsDaw.collapsePlaylist",
          "when": "view == vsDaw.playlist",
          "group": "navigation"
        },
        {
          "command": "vsDaw.openManual",
          "when": "view == vsDaw.playlist",
          "group": "navigation"
        },
        {
          "command": "vsDaw.openManual",
          "when": "view == vsDaw.recorder",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "vsDaw.playPause",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorLangId == vs-daw"
      },
      {
        "command": "vsDaw.restart",
        "key": "ctrl+shift+enter",
        "mac": "cmd+shift+enter",
        "when": "editorLangId == vs-daw"
      },
      {
        "command": "vsDaw.togglePadMode",
        "key": "ctrl+d",
        "mac": "cmd+d",
        "when": "!inputFocus && !editorTextFocus"
      },
      {
        "command": "vsDaw.togglePadMode",
        "key": "ctrl+'",
        "mac": "cmd+'",
        "when": "editorLangId == vs-daw && !inputFocus"
      },
      {
        "command": "vsDaw.exitPadMode",
        "key": "escape",
        "when": "vsDaw.padMode && !inputFocus"
      },
      {
        "command": "vsDaw.padHit",
        "key": "z",
        "when": "vsDaw.padMode && !inputFocus || vsDaw.padMode && editorTextFocus && editorLangId == vs-daw",
        "args": "z"
      },
      {
        "command": "vsDaw.padHit",
        "key": "x",
        "when": "vsDaw.padMode && !inputFocus || vsDaw.padMode && editorTextFocus && editorLangId == vs-daw",
